<aurora-bg></aurora-bg>
<view class="page">
  <view class="tabs">
    <view class="tab {{tab === 'ongoing' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
    <view class="tab {{tab === 'ended' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="ended">已结束</view>
  </view>

  <view class="card activity-card acard" wx:for="{{activities}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="act-top">
      <view class="act-title">{{item.title}}</view>
      <view class="type-badge" style="background:{{item.color}}1F;color:{{item.color}}"><image class="tag-icon" src="{{item.typeIcon}}"/> {{item.typeName}}</view>
    </view>
    <view class="act-meta">🕐 {{item.timeText}}</view>
    <view class="act-meta">📍 {{item.location || '地点待定'}}</view>
    <view class="act-foot">
      <text class="act-join">👥 {{item.confirmed}} 人参加</text>
      <text class="act-detail">详情 ›</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!activities.length}}">
    <view class="empty-icon">🗂️</view>
    <view class="empty-text">{{tab === 'ongoing' ? '还没有进行中的活动' : '还没有已结束的活动'}}</view>
  </view>
</view>

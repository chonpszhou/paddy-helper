page {
  background: #0A0F1E;
  color: #EAF0F8;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.page {
  padding: 24rpx 24rpx 180rpx;
  position: relative;
  z-index: 1;
}

.card {
  background: rgba(21, 29, 50, 0.62);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28), 0 16rpx 40rpx rgba(0, 0, 0, 0.34);
  margin-bottom: 24rpx;
  animation: cardIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.primary-btn {
  background: linear-gradient(135deg, #00E5A0, #00C896);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-weight: 600;
  font-size: 30rpx;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(0, 229, 160, 0.24), 0 0 24rpx rgba(0, 229, 160, 0.12);
}

.press-hover {
  transform: scale(0.96);
  opacity: 0.9;
  transition: transform 0.15s ease;
}

button::after {
  border: none;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 36rpx 4rpx 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #EAF0F8;
}

.section-more {
  font-size: 26rpx;
  color: #8B95A7;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #EAF0F8;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #8B95A7;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.glass {
  background: rgba(21, 29, 50, 0.72);
}

.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-state-icon {
  font-size: 84rpx;
  margin-bottom: 20rpx;
}

.empty-state-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #C7D0DE;
}

.empty-state-sub {
  font-size: 24rpx;
  color: #7C8698;
  margin-top: 10rpx;
}

.back-btn {
  display: inline-block;
  margin-top: 40rpx;
  background: linear-gradient(135deg, #00E5A0, #00C896);
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  padding: 16rpx 60rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 229, 160, 0.25);
}

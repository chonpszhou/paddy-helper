.detail-page {
  padding: 0 0 260rpx;
}

.preview-page {
  padding: 48rpx 32rpx 80rpx;
}

.preview-card {
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  padding: 44rpx 40rpx 52rpx;
  color: #FFFFFF;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.36);
  animation: riseIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.preview-blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  filter: blur(8px);
}

.pb1 {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -70rpx;
}

.pb2 {
  width: 140rpx;
  height: 140rpx;
  left: 50rpx;
  bottom: -50rpx;
}

.preview-lock {
  display: inline-block;
  font-size: 23rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}

.preview-title {
  position: relative;
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 26rpx;
  letter-spacing: 1rpx;
  line-height: 1.35;
}

.preview-meta {
  position: relative;
  margin-top: 14rpx;
  font-size: 26rpx;
  opacity: 0.95;
}

.preview-desc {
  position: relative;
  margin-top: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.preview-info {
  margin-top: 28rpx;
  background: rgba(21, 29, 50, 0.78);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 34rpx;
  padding: 32rpx 30rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.34);
  animation: riseIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.08s both;
}

.preview-join {
  font-size: 28rpx;
  font-weight: 800;
  color: #EAF0F8;
}

.preview-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8B95A7;
  line-height: 1.65;
  background: rgba(0, 229, 160, 0.10);
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
}

.preview-btn {
  margin-top: 28rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.preview-back {
  text-align: center;
  margin-top: 22rpx;
  font-size: 25rpx;
  color: #7C8698;
  font-weight: 600;
}

.hero {
  position: relative;
  overflow: hidden;
  color: #FFFFFF;
  padding: 48rpx 36rpx 96rpx;
  border-radius: 0 0 44rpx 44rpx;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.36);
}

.hero-ball {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  filter: blur(8px);
  animation: floaty 6s ease-in-out infinite alternate;
}

.hb1 {
  width: 220rpx;
  height: 220rpx;
  right: -50rpx;
  top: -60rpx;
}

.hb2 {
  width: 150rpx;
  height: 150rpx;
  right: 200rpx;
  bottom: -50rpx;
  animation-delay: -2.5s;
}

.hb3 {
  width: 90rpx;
  height: 90rpx;
  left: 60rpx;
  bottom: 20rpx;
  animation-delay: -4.5s;
}

@keyframes floaty {
  from {
    transform: translate(0, 0);
  }
  to {
    transform: translate(-28rpx, 24rpx);
  }
}

.hero-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-tag {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.24);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.hero-tag-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.hero-status {
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.24);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.hero-title {
  position: relative;
  font-size: 44rpx;
  font-weight: 800;
  margin-top: 26rpx;
  letter-spacing: 1rpx;
}

.hero-meta {
  position: relative;
  margin-top: 20rpx;
}

.hm {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  opacity: 0.94;
  margin-top: 10rpx;
}

.hm-addr {
  opacity: 0.72;
  font-size: 23rpx;
  padding-left: 38rpx;
}

.mi-w {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  opacity: 0.92;
}

.hero-desc {
  position: relative;
  margin-top: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.float-card {
  position: relative;
  z-index: 2;
  margin: -78rpx 28rpx 0;
  background: rgba(21, 29, 50, 0.78);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 34rpx;
  padding: 30rpx 28rpx;
  box-shadow: 0 18rpx 48rpx rgba(0, 0, 0, 0.42);
  animation: riseIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.float-stats {
  display: flex;
  align-items: center;
}

.fs {
  flex: 1;
  text-align: center;
}

.fs-n {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.fs-l {
  display: block;
  font-size: 23rpx;
  color: #8B95A7;
  margin-top: 10rpx;
}

.fs-div {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.10);
}

.signup-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.signup-btn {
  flex: 1;
  text-align: center;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
  font-weight: 600;
  color: #C7D0DE;
}

.signup-btn-active {
  background: #00E5A0;
  color: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(0, 229, 160, 0.28);
}

.note-row {
  margin-top: 18rpx;
}

.checkin-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  background: rgba(0, 229, 160, 0.10);
  border: 1rpx solid rgba(0, 229, 160, 0.22);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
}

.ended-tip {
  margin-top: 18rpx;
  text-align: center;
  font-size: 25rpx;
  color: #7C8698;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 999rpx;
  padding: 16rpx 24rpx;
}

.checkin-row-on {
  background: rgba(0, 229, 160, 0.18);
  border-color: rgba(0, 229, 160, 0.36);
}

.checkin-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.checkin-text {
  flex: 1;
  font-size: 25rpx;
  font-weight: 600;
  color: #EAF0F8;
}

.checkin-count {
  font-size: 23rpx;
  font-weight: 700;
  color: #00E5A0;
  background: rgba(0, 229, 160, 0.14);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}

.countdown-card {
  position: relative;
  z-index: 2;
  margin: 24rpx 28rpx 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: rgba(21, 29, 50, 0.72);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 30rpx;
  padding: 26rpx 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.34);
  animation: riseIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.countdown-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  background: linear-gradient(135deg, #10B981, #0EA5E9);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.28);
  flex-shrink: 0;
}

.countdown-card.ended .countdown-icon {
  background: linear-gradient(135deg, #7C8698, #C6CCD4);
  box-shadow: 0 8rpx 20rpx rgba(100, 116, 139, 0.2);
}

.countdown-card.live .countdown-icon {
  background: linear-gradient(135deg, #FF8A5B, #FF7A93);
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 147, 0.28);
}

.countdown-text {
  font-size: 30rpx;
  font-weight: 800;
  color: #EAF0F8;
  line-height: 1.45;
}

.note-input {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.group {
  margin: 28rpx 28rpx 0;
}

.group-head {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #EAF0F8;
  margin-bottom: 14rpx;
  padding: 0 6rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.group-count {
  font-size: 23rpx;
  color: #7C8698;
  font-weight: 500;
  margin-left: 10rpx;
}

.inset {
  background: rgba(21, 29, 50, 0.66);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.24), 0 12rpx 32rpx rgba(0, 0, 0, 0.30);
}

.inset-pad {
  padding: 24rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: calc((100% - 32rpx) / 3);
}

.photo-wrap {
  position: relative;
}

.photo-img {
  width: 100%;
  height: 190rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.06);
}

.photo-rank {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  font-size: 34rpx;
  line-height: 1;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
}

.photo-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.photo-vote {
  font-size: 21rpx;
  color: #8B95A7;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 999rpx;
  padding: 6rpx 12rpx;
}

.photo-vote-on {
  background: rgba(0, 229, 160, 0.16);
  color: #00E5A0;
  font-weight: 600;
}

.photo-vote-on-bad {
  background: rgba(255, 255, 255, 0.12);
  color: #C7D0DE;
  font-weight: 600;
}

.photo-score {
  font-size: 21rpx;
  color: #7C8698;
}

.photo-upload {
  text-align: center;
  margin-top: 22rpx;
  background: #00E5A0;
  color: #FFFFFF;
  border-radius: 999rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(0, 229, 160, 0.24);
}

.inset-row {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.07);
}

.inset-row:last-child {
  border-bottom: none;
}

.inset-row-center {
  justify-content: space-between;
}

.inset-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #C7D0DE;
  line-height: 1.6;
}

.inset-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  background: #00E5A0;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 229, 160, 0.24);
}

.empty-mini {
  font-size: 24rpx;
  color: #7C8698;
  text-align: center;
  padding: 28rpx 0;
}

.member-emoji {
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 34rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 28rpx;
  font-weight: 700;
}

.member-note {
  font-size: 23rpx;
  color: #7C8698;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-status {
  font-size: 23rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.member-checkin {
  font-size: 21rpx;
  font-weight: 700;
  color: #00E5A0;
  background: rgba(0, 229, 160, 0.14);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 998;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  background: rgba(21, 29, 50, 0.66);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 52rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.50);
}

.bb-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.09);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bb-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.bb-main {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #00E5A0;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 26rpx rgba(0, 229, 160, 0.28);
}

.mi {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

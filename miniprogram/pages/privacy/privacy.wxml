<aurora-bg></aurora-bg>
<view class="page">
  <view class="head">
    <view class="head-title">Paddy小助手 · 隐私政策</view>
    <view class="head-sub">更新日期：2026-08-06</view>
  </view>

  <view class="card" wx:for="{{sections}}" wx:key="title">
    <view class="sec-title">{{index + 1}}. {{item.title}}</view>
    <view class="sec-item" wx:for="{{item.items}}" wx:for-item="it" wx:key="*this">
      <view class="dot"></view>
      <text class="sec-text">{{it}}</text>
    </view>
  </view>

  <view class="foot">本小程序仅用于亲友之间的周末活动组织，不收集非必要的个人信息。</view>
</view>

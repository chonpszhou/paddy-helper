.page {
  padding: 20rpx 28rpx 220rpx;
}

.rise {
  animation: riseIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(26rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.hero-greet {
  padding: 24rpx 8rpx 10rpx;
}

.hi {
  font-size: 30rpx;
  color: #8B95A7;
}

.name {
  font-size: 46rpx;
  font-weight: 800;
  color: #F2F6FC;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.circle-chip {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #A78BFA;
  background: rgba(139, 92, 246, 0.16);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}

.overview-card {
  display: flex;
  align-items: center;
  background: rgba(21, 29, 50, 0.62);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 32rpx;
  padding: 28rpx 0;
  margin: 22rpx 0 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28), 0 16rpx 40rpx rgba(0, 0, 0, 0.34);
}

.ov {
  flex: 1;
  text-align: center;
}

.ov-n {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.ov-l {
  font-size: 24rpx;
  color: #8B95A7;
  margin-top: 10rpx;
}

.ov-div {
  width: 1rpx;
  height: 56rpx;
  background: rgba(255, 255, 255, 0.08);
}

.circle-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 0 26rpx;
  padding: 26rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.18), rgba(14, 165, 233, 0.14));
  border: 1rpx solid rgba(139, 92, 246, 0.30);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.28), 0 0 28rpx rgba(139, 92, 246, 0.12);
}

.circle-banner-icon {
  font-size: 52rpx;
}

.circle-banner-texts {
  flex: 1;
  min-width: 0;
}

.circle-banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #F2F6FC;
}

.circle-banner-sub {
  font-size: 23rpx;
  color: #A7B0C2;
  margin-top: 4rpx;
}

.circle-banner-go {
  font-size: 26rpx;
  font-weight: 700;
  color: #A78BFA;
  flex-shrink: 0;
}

.chips {
  display: flex;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 16rpx;
  background: transparent;
  color: #8B95A7;
  font-size: 25rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.chip.on {
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.3);
}

.feature {
  background: rgba(21, 29, 50, 0.8);
  border-radius: 34rpx;
  overflow: hidden;
  margin-bottom: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3), 0 18rpx 44rpx rgba(0, 0, 0, 0.38);
  animation: riseIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.cover {
  position: relative;
  overflow: hidden;
  padding: 30rpx 32rpx 34rpx;
  color: #FFFFFF;
}

.cover-ball {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  filter: blur(10px);
  animation: floaty 6s ease-in-out infinite alternate;
}

.cb1 {
  width: 180rpx;
  height: 180rpx;
  right: -30rpx;
  top: -40rpx;
}

.cb2 {
  width: 120rpx;
  height: 120rpx;
  right: 120rpx;
  bottom: -40rpx;
  animation-delay: -3s;
}

@keyframes floaty {
  from {
    transform: translate(0, 0);
  }
  to {
    transform: translate(-24rpx, 20rpx);
  }
}

.cover-top {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cover-tag {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.24);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.cover-tag-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
}

.cover-badge {
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.24);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.cover-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.cover-countdown {
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.26);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.cover-title {
  position: relative;
  font-size: 42rpx;
  font-weight: 800;
  margin-top: 26rpx;
  letter-spacing: 1rpx;
}

.cover-meta {
  position: relative;
  margin-top: 18rpx;
}

.cm {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  opacity: 0.92;
  margin-top: 8rpx;
}

.mi-w {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  opacity: 0.9;
}

.feature-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 30rpx;
}

.avatars {
  display: flex;
}

.av {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  margin-left: -14rpx;
}

.av:first-child {
  margin-left: 0;
}

.av-more {
  background: rgba(255, 255, 255, 0.12);
  color: #A7B0C2;
}

.feature-join {
  display: flex;
  align-items: center;
  font-size: 25rpx;
  color: #C7D0DE;
  font-weight: 600;
}

.mi {
  width: 26rpx;
  height: 26rpx;
  margin-right: 6rpx;
}

.mi.sm {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}

.sec-head {
  margin: 8rpx 8rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #F2F6FC;
}

.sec-more {
  font-size: 24rpx;
  color: #7C8698;
  font-weight: 500;
  padding: 4rpx 8rpx;
}

.row-card {
  display: flex;
  align-items: center;
  background: rgba(21, 29, 50, 0.62);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 26rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.26), 0 10rpx 28rpx rgba(0, 0, 0, 0.32);
  animation: riseIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.row-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 29rpx;
  font-weight: 700;
  color: #EAF0F8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-meta {
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #8B95A7;
  margin-top: 6rpx;
}

.row-count {
  display: inline-block;
  margin-left: 10rpx;
  font-size: 21rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 229, 160, 0.14);
  color: #00E5A0;
}

.row-count.ended {
  background: rgba(154, 160, 175, 0.16);
  color: #8B95A7;
}

.row-count.live {
  background: rgba(255, 92, 122, 0.16);
  color: #FF7A93;
}

.row-tag {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

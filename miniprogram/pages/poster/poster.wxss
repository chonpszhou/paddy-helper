.page {
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.preview-wrap {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 16rpx 48rpx rgba(16, 24, 40, 0.1);
  min-height: 700rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-img {
  width: 100%;
  display: block;
}

.generating {
  text-align: center;
  padding: 120rpx 0;
}

.loading-ring {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(7, 193, 96, 0.15);
  border-top-color: #07C160;
  margin: 0 auto 24rpx;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.generating-text {
  font-size: 26rpx;
  color: #9A8F86;
}

.gen-error {
  text-align: center;
  padding: 120rpx 0;
}

.gen-error-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.gen-error-text {
  font-size: 26rpx;
  color: #9A8F86;
}

.ai-style-card {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(16, 24, 40, 0.09);
}

.ai-style-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0E1116;
  margin-bottom: 20rpx;
}

.style-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.style-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #3D4450;
  background: rgba(15, 23, 42, 0.05);
  border: 1rpx solid transparent;
}

.style-chip-on {
  color: #7C3AED;
  background: rgba(139, 92, 246, 0.12);
  border-color: rgba(139, 92, 246, 0.35);
  font-weight: 600;
}

.ai-prompt-input {
  height: 80rpx;
  background: rgba(255, 255, 255, 0.75);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.ai-gen-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #8B5CF6, #0EA5E9);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.24);
}

.ai-gen-btn[disabled] {
  opacity: 0.75;
}

.ai-style-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B0A79E;
  text-align: center;
}

.actions {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.save-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.share-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: rgba(255, 255, 255, 0.75);
  color: #3D4450;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #B0A79E;
  margin-top: 24rpx;
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 400px;
}

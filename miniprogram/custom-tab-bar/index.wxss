.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar {
  pointer-events: auto;
  display: flex;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(15, 21, 38, 0.72);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.45), 0 0 32rpx rgba(0, 229, 160, 0.06);
}

.tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tb-icon {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tb.spin .tb-icon {
  transform: rotate(90deg) scale(0.9);
}

.tb-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #8B95A7;
  line-height: 1;
}

.tb.on .tb-text {
  color: #00E5A0;
  font-weight: 600;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
}

.head-sub {
  font-size: 26rpx;
  color: #9A8F86;
  margin-top: 10rpx;
}

.head-loc {
  color: #4A9EFF;
}

.head-addr {
  font-size: 23rpx;
  color: #B0A79E;
}

.final-banner {
  margin-top: 18rpx;
  background: #EAF8F1;
  color: #1F8A58;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.title-tip {
  font-size: 22rpx;
  color: #C4B9AE;
  font-weight: 400;
  margin-left: 8rpx;
}

.map {
  width: 100%;
  height: 420rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.map-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #9A8F86;
}

.legend-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.legend-star {
  background: #E8483F;
  border-radius: 4rpx;
  transform: rotate(45deg);
}

.legend-org {
  background: #07C160;
}

.legend-purple {
  background: #8B6CF6;
}

.center-text {
  font-size: 25rpx;
  color: #6F675F;
  margin-top: 16rpx;
}

.center-coord {
  color: #E8483F;
  font-weight: 700;
}

.warn-card {
  background: #FFF7E8;
}

.warn {
  font-size: 24rpx;
  color: #D97706;
  line-height: 1.6;
}

.venue {
  background: #FBF6F0;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}

.venue-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.venue-info {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.venue-name {
  font-size: 29rpx;
  font-weight: 700;
}

.venue-final {
  color: #1F8A58;
  font-size: 24rpx;
}

.venue-address {
  font-size: 23rpx;
  color: #9A8F86;
  margin-top: 6rpx;
}

.venue-voters {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.venue-voters-text {
  font-size: 22rpx;
  margin-right: 12rpx;
}

.venue-count {
  font-size: 22rpx;
  color: #9A8F86;
}

.venue-vote {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9A8F86;
  border: 2rpx solid #E4D8CC;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
}

.venue-vote-on {
  background: linear-gradient(135deg, #9C85F9, #7C5CFC);
  color: #FFFFFF;
  border-color: transparent;
  font-weight: 600;
}

.venue-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #EADFD3;
}

.venue-action {
  font-size: 23rpx;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.venue-action-final {
  background: #FFFFFF;
  color: #8B6CF6;
  border: 2rpx solid #D8CCFB;
  font-weight: 600;
}

.venue-action-del {
  color: #FF4D4F;
  border: 2rpx solid #FFD6D6;
}

.add-line {
  text-align: center;
  color: #07C160;
  font-size: 26rpx;
  font-weight: 600;
  padding: 16rpx 0 4rpx;
}

/* 🐺 狼人杀 */
.wolf-card {
  background: linear-gradient(150deg, rgba(88, 28, 135, 0.06), rgba(185, 28, 28, 0.06));
  border: 1rpx solid rgba(88, 28, 135, 0.18);
}

.wolf-deck-card {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(124, 58, 237, 0.16);
  border-radius: 24rpx;
  padding: 24rpx;
}

.wolf-deck-line {
  font-size: 26rpx;
  color: #3D4450;
}

.wolf-deck-num {
  font-weight: 800;
  color: #7C3AED;
}

.wolf-deck-roles {
  margin-top: 12rpx;
  font-size: 27rpx;
  font-weight: 800;
  color: #0E1116;
  line-height: 1.6;
}

.wolf-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.wolf-preset {
  width: calc((100% - 16rpx) / 2);
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 22rpx;
  padding: 20rpx;
}

.wolf-preset-on {
  border-color: #7C3AED;
  background: rgba(124, 58, 237, 0.08);
}

.wolf-preset-name {
  font-size: 27rpx;
  font-weight: 800;
  color: #0E1116;
}

.wolf-preset-roles {
  font-size: 21rpx;
  color: #8A919E;
  margin-top: 8rpx;
  line-height: 1.5;
}

.wolf-tip {
  font-size: 24rpx;
  color: #6B7480;
  margin-top: 22rpx;
}

.wolf-start {
  margin-top: 22rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8B5CF6, #C026D3);
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 26rpx rgba(139, 92, 246, 0.3);
}

.wolf-start:active {
  transform: scale(0.96);
}

.wolf-phase-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.wolf-phase-tag {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 18rpx 24rpx;
  text-align: center;
}

.wolf-night {
  background: #1E1B3A;
  color: #C7C4FF;
}

.wolf-day {
  background: #FFF4D6;
  color: #B7791F;
}

.wolf-phase-btn {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 700;
  color: #7C3AED;
  background: rgba(124, 58, 237, 0.1);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
}

.wolf-summary {
  font-size: 23rpx;
  color: #8A919E;
  margin-top: 18rpx;
}

.wolf-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.wolf-item {
  width: calc((100% - 32rpx) / 3);
}

.wolf-face {
  background: linear-gradient(145deg, #5B21B6, #3B0764);
  border-radius: 20rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(59, 7, 100, 0.25);
}

.wolf-face-open {
  background: #FFFFFF;
  border: 2rpx solid rgba(124, 58, 237, 0.25);
  box-shadow: 0 8rpx 20rpx rgba(16, 24, 40, 0.08);
}

.wolf-face-dead {
  opacity: 0.55;
  filter: grayscale(0.8);
}

.wolf-role-icon {
  font-size: 48rpx;
  line-height: 1;
}

.wolf-role-name {
  font-size: 24rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.wolf-face-open .wolf-role-name {
  color: #0E1116;
}

.wolf-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.wolf-name {
  font-size: 22rpx;
  color: #3D4450;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wolf-alive {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #047857;
  background: rgba(4, 120, 87, 0.1);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.wolf-alive-dead {
  color: #B91C1C;
  background: rgba(185, 28, 28, 0.1);
}

.wolf-actions {
  margin-top: 22rpx;
  display: flex;
  justify-content: center;
}

.wolf-act {
  font-size: 25rpx;
  color: #8A919E;
  border: 2rpx solid rgba(15, 23, 42, 0.1);
  border-radius: 999rpx;
  padding: 14rpx 40rpx;
}

.wolf-act-danger {
  color: #B91C1C;
  border-color: rgba(185, 28, 28, 0.2);
}

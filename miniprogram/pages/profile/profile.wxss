.me-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.me-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.me-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #06AD56, #00E5A0);
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.me-avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.10);
}

.me-name {
  font-size: 34rpx;
  font-weight: 700;
}

.me-intro {
  font-size: 24rpx;
  color: #7C8698;
  margin-top: 8rpx;
}

.me-authed {
  font-size: 22rpx;
  color: #00E5A0;
  font-weight: 600;
}

.me-edit {
  font-size: 25rpx;
  color: #00E5A0;
  font-weight: 600;
  flex-shrink: 0;
}

.row-card {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  gap: 20rpx;
}

.row-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.row-icon-img {
  width: 34rpx;
  height: 34rpx;
}

.row-label {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 600;
}

.row-value {
  font-size: 25rpx;
  color: #7C8698;
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-chev {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.mine {
  margin-bottom: 20rpx;
}

.mine-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-badge {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.mine-status {
  font-size: 24rpx;
  color: #7C8698;
}

.mine-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 14rpx 0 8rpx;
}

.mine-meta {
  font-size: 25rpx;
  color: #8B95A7;
}

.mine-count {
  display: inline-block;
  margin-left: 10rpx;
  font-size: 21rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(0, 229, 160, 0.14);
  color: #00E5A0;
}

.mine-count.ended {
  background: rgba(154, 160, 175, 0.14);
  color: #8B95A7;
}

.mine-count.live {
  background: rgba(255, 92, 122, 0.12);
  color: #FF7A93;
}

.stats-card {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}

.st {
  flex: 1;
  text-align: center;
}

.st-n {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.st-l {
  font-size: 23rpx;
  color: #8B95A7;
  margin-top: 10rpx;
}

.st-div {
  width: 1rpx;
  height: 52rpx;
  background: rgba(255, 255, 255, 0.10);
}

.about {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.about-line {
  font-size: 24rpx;
  color: #C4B9AE;
  margin-bottom: 8rpx;
}

.reset-link {
  font-size: 24rpx;
  color: #7C8698;
  text-decoration: underline;
  margin-top: 20rpx;
}

.tabbar-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 16rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tabbar {
  pointer-events: auto;
  display: flex;
  height: 116rpx;
  border-radius: 58rpx;
  background: rgba(255, 255, 255, 0.7);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 16rpx 48rpx rgba(16, 24, 40, 0.14);
}

.tb {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tb-icon {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.26s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tb.spin .tb-icon {
  transform: rotate(90deg) scale(0.9);
}

.tb-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #9AA3AF;
  line-height: 1;
}

.tb.on .tb-text {
  color: #07C160;
  font-weight: 600;
}

.page {
  padding: 32rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.preview-wrap {
  border-radius: 28rpx;
  overflow: hidden;
  background: rgba(21, 29, 50, 0.7);
  box-shadow: 0 16rpx 48rpx rgba(16, 24, 40, 0.1);
  min-height: 700rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-img {
  width: 100%;
  display: block;
}

.generating {
  text-align: center;
  padding: 120rpx 0;
}

.loading-ring {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(7, 193, 96, 0.15);
  border-top-color: #00E5A0;
  margin: 0 auto 24rpx;
  animation: spin 0.9s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.generating-text {
  font-size: 26rpx;
  color: #7C8698;
}

.gen-error {
  text-align: center;
  padding: 120rpx 0;
}

.gen-error-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.gen-error-text {
  font-size: 26rpx;
  color: #7C8698;
}

.ai-style-card {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(21, 29, 50, 0.58);
  -webkit-backdrop-filter: blur(24px) saturate(160%);
  backdrop-filter: blur(24px) saturate(160%);
  border: 1rpx solid rgba(21, 29, 50, 0.72);
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.30);
}

.ai-style-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #EAF0F8;
  margin-bottom: 20rpx;
}

.style-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.style-chip {
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #C7D0DE;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid transparent;
}

.style-chip-on {
  color: #A78BFA;
  background: rgba(139, 92, 246, 0.12);
  border-color: rgba(139, 92, 246, 0.35);
  font-weight: 600;
}

.ai-prompt-input {
  height: 80rpx;
  background: rgba(21, 29, 50, 0.62);
  border: 1rpx solid rgba(255, 255, 255, 0.10);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.ai-gen-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #8B5CF6, #0EA5E9);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.24);
}

.ai-gen-btn[disabled] {
  opacity: 0.75;
}

.ai-style-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #7C8698;
  text-align: center;
}

.actions {
  margin-top: 36rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.save-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.share-btn {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: rgba(21, 29, 50, 0.62);
  color: #C7D0DE;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #7C8698;
  margin-top: 24rpx;
}

.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 300px;
  height: 400px;
}

<aurora-bg></aurora-bg>
<view class="page" wx:if="{{activity}}">
  <view class="card head">
    <view class="head-title">🎲 {{activity.title}}</view>
    <view class="head-sub">🕐 {{timeText}}</view>
    <view class="head-sub head-loc" bindtap="openLocation">📍 {{activity.location || '地点待定'}}</view>
    <view class="head-sub head-addr" wx:if="{{activity.locationAddress && activity.locationAddress !== activity.location}}">{{activity.locationAddress}}</view>
    <view class="final-banner" wx:if="{{hasFinal}}">✅ 已选定场馆：{{finalName}}</view>
  </view>

  <view class="card wolf-card" wx:if="{{groupGame === 'werewolf'}}">
    <view class="card-title">🐺 狼人杀 <text class="title-tip">先认领上帝，再开局</text></view>

    <block wx:if="{{wolf.phase === 'ready'}}">
      <block wx:if="{{noGod}}">
        <view class="wolf-claim-card">
          <view class="wolf-claim-title">👑 需要一位上帝</view>
          <view class="wolf-claim-desc">上帝负责配牌、标记出局、切换天黑天亮，全场由他主持。谁想当，点下面认领～</view>
          <view class="wolf-claim-btn" bindtap="claimGod" hover-class="press-hover">🙋 我来当上帝</view>
        </view>
      </block>
      <block wx:else>
        <view class="wolf-god-tip" wx:if="{{isGod}}">👑 你是上帝（{{godName}}），负责配牌和全场管理</view>
        <view class="wolf-wait-tip" wx:else>🕐 上帝「{{godName}}」正在配牌，稍等一下…</view>
        <view class="wolf-deck-card" wx:if="{{isGod}}">
          <view class="wolf-deck-line">👥 确认参加 <text class="wolf-deck-num">{{wolfPlayerCount}}</text> 人</view>
          <view class="wolf-deck-line">自动配牌（6-15 人自适应）：</view>
          <view class="wolf-deck-roles">{{wolfDeckText}}</view>
          <view class="wolf-tip">分配后角色打乱，点卡片翻牌查看身份</view>
        </view>
        <view class="wolf-start" wx:if="{{isGod}}" bindtap="startWolf" hover-class="press-hover">🎲 按此配置随机分配</view>
        <view class="wolf-resign" wx:if="{{isGod}}" bindtap="resignGod" hover-class="press-hover">让出上帝身份</view>
    </block>
    </block>

    <block wx:else>
      <view class="wolf-phase-bar">
        <view class="wolf-phase-tag {{wolf.phase === 'night' ? 'wolf-night' : 'wolf-day'}}">{{wolf.phase === 'night' ? '🌙 天黑请闭眼' : '☀️ 天亮请睁眼'}}</view>
        <view class="wolf-phase-btn" wx:if="{{isGod}}" bindtap="toggleWolfPhase" hover-class="press-hover">{{wolf.phase === 'night' ? '天亮 ☀️' : '天黑 🌙'}}</view>
      </view>
      <view class="wolf-summary">存活 {{wolfAliveCount }} / {{wolf.players.length}} 人{{isGod ? ' · 你是上帝，可翻任何牌' : ' · 点自己的牌看身份'}}</view>
      <view class="wolf-grid">
        <view class="wolf-item" wx:for="{{wolfPlayers}}" wx:key="uid">
          <view class="wolf-face {{item.revealed ? 'wolf-face-open' : ''}} {{item.dead ? 'wolf-face-dead' : ''}}" bindtap="flipWolfCard" data-uid="{{item.uid}}">
            <block wx:if="{{item.revealed}}">
              <view class="wolf-role-icon" style="background:{{item.roleColor}}22">{{item.roleIcon}}</view>
              <view class="wolf-role-name" style="color:{{item.roleColor}}">{{item.role}}</view>
            </block>
            <block wx:else>
              <view class="wolf-role-icon">{{item.isMe || isGod ? '🎴' : '🔒'}}</view>
              <view class="wolf-role-name">{{item.dead ? '已出局' : (item.isMe || isGod ? '点击翻牌' : '上帝专属')}}</view>
            </block>
          </view>
          <view class="wolf-foot">
            <text class="wolf-name">{{item.name}}{{item.isMe ? '（我）' : ''}}</text>
            <view class="wolf-alive {{item.dead ? 'wolf-alive-dead' : ''}}" wx:if="{{isGod}}" catchtap="toggleWolfAlive" data-uid="{{item.uid}}">{{item.dead ? '出局' : '存活'}}</view>
            <view class="wolf-alive {{item.dead ? 'wolf-alive-dead' : ''}}" wx:else>{{item.dead ? '出局' : '存活'}}</view>
          </view>
        </view>
      </view>
      <view class="wolf-actions" wx:if="{{isGod}}">
        <view class="wolf-act wolf-act-danger" bindtap="resetWolf" hover-class="press-hover">↻ 重新分配</view>
      </view>
    </block>
  </view>

  <view class="card" wx:if="{{center}}">
    <view class="card-title">🗺️ 居中地点</view>
    <map class="map" latitude="{{mapLat}}" longitude="{{mapLng}}" markers="{{markers}}" scale="12"/>
    <view class="map-legend">
      <view class="legend-item"><view class="legend-dot legend-star"></view>居中点</view>
      <view class="legend-item"><view class="legend-dot legend-org"></view>参加者</view>
      <view class="legend-item"><view class="legend-dot legend-purple"></view>候选场馆</view>
    </view>
    <view class="center-text">根据 {{locatedCount}} 位参加者的位置，居中点约在 <text class="center-coord">{{centerText}}</text></view>
  </view>

  <view class="card" wx:else>
    <view class="card-title">🗺️ 居中地点</view>
    <view class="empty">
      <view class="empty-icon">📍</view>
      <view class="empty-text">设置好参加者的位置后，这里会自动算出最居中的地点</view>
    </view>
  </view>

  <view class="card warn-card" wx:if="{{missingNames.length}}">
    <view class="warn">⚠️ 还有 {{missingNames.length}} 位朋友没设置位置（{{missingNamesText}}），居中点会不太准</view>
  </view>

  <view class="card">
    <view class="card-title">🏟️ 候选场馆 <text class="title-tip">按距居中点远近排序</text></view>
    <view class="venue" wx:for="{{venues}}" wx:key="id">
      <view class="venue-main" bindtap="toggleVote" data-venue-id="{{item.id}}">
        <view class="venue-info">
          <view class="venue-name">{{item.name}}<text class="venue-final" wx:if="{{item.isFinal}}"> ✅ 已选定</text></view>
          <view class="venue-address">📍 {{item.address || '地址待补充'}} · 距居中点 {{item.distanceText || '未计算'}}</view>
          <view class="venue-voters">
            <text class="venue-voters-text">{{item.votersText}}</text>
            <text class="venue-count">{{item.voteCount}} 人想去</text>
          </view>
        </view>
        <view class="venue-vote {{item.voted ? 'venue-vote-on' : ''}}">{{item.voted ? '✓ 想去' : '想去'}}</view>
      </view>
      <view class="venue-actions">
        <view class="venue-action venue-action-final" bindtap="setFinal" data-venue-id="{{item.id}}">{{item.isFinal ? '取消选定' : '定这家'}}</view>
        <view class="venue-action venue-action-del" wx:if="{{item.isMine || isCreator}}" catchtap="removeVenue" data-venue-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!venues.length}}">
      <view class="empty-icon">🏟️</view>
      <view class="empty-text">还没有候选场馆，添加一个吧</view>
    </view>
    <view class="add-line" bindtap="addVenue">＋ 添加候选场馆（地图选点）</view>
  </view>
</view>

<view class="page" wx:else>
  <view class="card empty-state">
    <view class="empty-state-icon">😵</view>
    <view class="empty-state-text">页面暂时打不开</view>
    <view class="empty-state-sub">活动可能已不存在，试试重新打开</view>
    <view class="back-btn" bindtap="goBack">返回</view>
  </view>
</view>

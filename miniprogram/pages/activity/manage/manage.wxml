<aurora-bg></aurora-bg>
<view class="page">
  <view class="manage-note">这里删除只影响你自己的列表，不会动共享数据</view>

  <view class="tabs">
    <view class="tab {{tab === 'ongoing' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中</view>
    <view class="tab {{tab === 'ended' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="ended">已结束</view>
  </view>

  <view class="card act-card" wx:for="{{activities}}" wx:key="id">
    <view class="act-main" bindtap="goDetail" data-id="{{item.id}}">
      <view class="act-top">
        <view class="type-badge" style="background:{{item.color}}1F;color:{{item.color}}"><image class="tag-icon" src="{{item.typeIcon}}"/> {{item.typeName}}</view>
        <view class="act-join">👥 {{item.confirmed}} 人</view>
      </view>
      <view class="act-title">{{item.title}}</view>
      <view class="act-meta">🕐 {{item.timeText}}</view>
      <view class="act-meta">📍 {{item.location || '地点待定'}}</view>
    </view>
    <view class="act-actions">
      <view class="del-btn" catchtap="removeActivity" data-id="{{item.id}}" data-title="{{item.title}}">删除</view>
    </view>
  </view>

  <view class="empty" wx:if="{{!activities.length}}">
    <view class="empty-icon">🗂️</view>
    <view class="empty-text">{{tab === 'ongoing' ? '没有进行中的活动' : '没有已结束的活动'}}</view>
  </view>

  <view class="add-line" bindtap="goCreate">＋ 发起新活动</view>
</view>

.comment {
  padding: 20rpx 26rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.comment:last-of-type {
  border-bottom: none;
}

.comment-head {
  display: flex;
  justify-content: space-between;
}

.comment-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #07C160;
}

.comment-time {
  font-size: 21rpx;
  color: #9AA3AF;
}

.comment-text {
  font-size: 27rpx;
  margin-top: 8rpx;
  color: #0E1116;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 26rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
}

.comment-input {
  flex: 1;
  background: #F2F3F5;
  border-radius: 999rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

.comment-send {
  background: #07C160;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
}

.bottom-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 998;
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  background: rgba(255, 255, 255, 0.78);
  -webkit-backdrop-filter: blur(24px) saturate(180%);
  backdrop-filter: blur(24px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 52rpx;
  box-shadow: 0 16rpx 48rpx rgba(16, 24, 40, 0.16);
}

.bb-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
}

.bb-primary {
  flex: 2;
  background: #07C160;
  color: #FFFFFF;
  box-shadow: 0 10rpx 26rpx rgba(7, 193, 96, 0.28);
}

.bb-ghost {
  background: rgba(255, 255, 255, 0.92);
  color: #0E1116;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.mi {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}

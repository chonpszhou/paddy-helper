.page {
  min-height: 100vh;
  padding: 120rpx 40rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero {
  text-align: center;
  margin-bottom: 52rpx;
}

.hero-emoji {
  font-size: 110rpx;
  line-height: 1;
  margin-bottom: 28rpx;
  animation: floaty 4s ease-in-out infinite;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #0E1116;
  letter-spacing: -1rpx;
}

.hero-sub {
  font-size: 30rpx;
  color: #3D4450;
  margin-top: 14rpx;
  font-weight: 600;
}

.hero-desc {
  font-size: 25rpx;
  color: #9AA3AF;
  margin-top: 12rpx;
}

@keyframes floaty {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-14rpx);
  }
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.step-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: rgba(255, 255, 255, 0.66);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 30rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.05), 0 16rpx 40rpx rgba(16, 24, 40, 0.09);
  animation: cardIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.step-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981, #0EA5E9);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-icon {
  font-size: 52rpx;
  flex-shrink: 0;
}

.step-texts {
  flex: 1;
  min-width: 0;
}

.step-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0E1116;
}

.step-desc {
  font-size: 24rpx;
  color: #6B7480;
  margin-top: 6rpx;
  line-height: 1.5;
}

.cta {
  margin-top: 56rpx;
  animation: cardIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.start-btn {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 32rpx;
}

.start-btn:active {
  transform: scale(0.96);
}

.skip {
  text-align: center;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #9AA3AF;
  padding: 12rpx 0;
}

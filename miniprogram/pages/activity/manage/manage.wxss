.manage-note {
  font-size: 24rpx;
  color: #7C8698;
  margin: 0 6rpx 20rpx;
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.68);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  border: 1rpx solid rgba(21, 29, 50, 0.62);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #7C8698;
  border-radius: 999rpx;
}

.tab-active {
  background: rgba(255, 255, 255, 0.10);
  color: #00E5A0;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 229, 160, 0.14);
}

.act-card {
  margin-bottom: 20rpx;
}

.act-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-badge {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.act-join {
  font-size: 24rpx;
  color: #7C8698;
}

.act-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 16rpx 0 10rpx;
}

.act-meta {
  font-size: 26rpx;
  color: #8B95A7;
  margin-top: 6rpx;
}

.act-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.10);
}

.act-actions-viewonly {
  font-size: 24rpx;
  color: #7C8698;
}

.mini-btn {
  font-size: 25rpx;
  color: #00E5A0;
  border: 2rpx solid #C9F0DC;
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  font-weight: 600;
}

.act-count {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0, 229, 160, 0.14);
  color: #00E5A0;
}

.act-count.ended {
  background: rgba(154, 160, 175, 0.14);
  color: #8B95A7;
}

.act-count.live {
  background: rgba(255, 92, 122, 0.12);
  color: #FF7A93;
}

.del-btn {
  font-size: 25rpx;
  color: #FF4D4F;
  border: 2rpx solid #FFD6D6;
  border-radius: 999rpx;
  padding: 10rpx 34rpx;
  font-weight: 600;
}

.add-line {
  text-align: center;
  color: #00E5A0;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0 8rpx;
}

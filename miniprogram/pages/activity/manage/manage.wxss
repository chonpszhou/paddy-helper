.manage-note {
  font-size: 24rpx;
  color: #B0A79E;
  margin: 0 6rpx 20rpx;
}

.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.68);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #9A8F86;
  border-radius: 999rpx;
}

.tab-active {
  background: #FFFFFF;
  color: #07C160;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.12);
}

.act-card {
  margin-bottom: 20rpx;
}

.act-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-badge {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.act-join {
  font-size: 24rpx;
  color: #9A8F86;
}

.act-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 16rpx 0 10rpx;
}

.act-meta {
  font-size: 26rpx;
  color: #6F675F;
  margin-top: 6rpx;
}

.act-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EFE8;
}

.del-btn {
  font-size: 25rpx;
  color: #FF4D4F;
  border: 2rpx solid #FFD6D6;
  border-radius: 999rpx;
  padding: 10rpx 34rpx;
  font-weight: 600;
}

.add-line {
  text-align: center;
  color: #07C160;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0 8rpx;
}

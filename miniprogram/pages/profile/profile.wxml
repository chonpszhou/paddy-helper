<aurora-bg></aurora-bg>
<view class="page">
  <view class="card me-card">
    <view class="me-left">
      <image wx:if="{{profile.avatar}}" class="me-avatar-img" src="{{profile.avatar}}" mode="aspectFill"/>
      <view wx:else class="me-avatar">{{avatarLetter}}</view>
      <view class="me-texts">
        <view class="me-name">{{displayName}}<text class="me-authed" wx:if="{{profile.wechatAuthed}}"> 已登录</text></view>
        <view class="me-intro">{{profile.intro}}</view>
      </view>
    </view>
    <view class="me-edit" bindtap="goLogin">{{profile.wechatAuthed ? '编辑 ›' : '登录 ›'}}</view>
  </view>

  <view class="card row-card" bindtap="editLocation">
    <text class="row-label">📍 我的位置</text>
    <text class="row-value">{{profile.location || '设置我的位置'}} ›</text>
  </view>

  <view class="card stats-card">
    <view class="st">
      <text class="st-n" style="color: #07C160">{{stats.created}}</text>
      <text class="st-l">组织</text>
    </view>
    <view class="st-div"></view>
    <view class="st">
      <text class="st-n" style="color: #8B5CF6">{{stats.joined}}</text>
      <text class="st-l">参加</text>
    </view>
    <view class="st-div"></view>
    <view class="st">
      <text class="st-n" style="color: #D99A2B">{{stats.maybe}}</text>
      <text class="st-l">待定</text>
    </view>
    <view class="st-div"></view>
    <view class="st">
      <text class="st-n" style="color: #0EA5E9">{{stats.upcoming}}</text>
      <text class="st-l">即将</text>
    </view>
  </view>

  <view class="card row-card" bindtap="manageCircle">
    <text class="row-label">🔐 我的圈子</text>
    <text class="row-value">{{circleName || '加入 / 创建圈子'}} ›</text>
  </view>

  <view class="card row-card" bindtap="enableNotify">
    <text class="row-label">🔔 活动通知</text>
    <text class="row-value">{{profile.subscribed ? '已开启 · 点此续期 ›' : '点此开启 ›'}}</text>
  </view>

  <view class="card row-card" bindtap="goManage">
    <text class="row-label">🗂️ 活动管理</text>
    <text class="row-value">{{manageCount}} 个活动 ›</text>
  </view>

  <view class="card row-card" bindtap="goFriends">
    <text class="row-label">👫 好友圈</text>
    <text class="row-value">添加 / 管理好友 ›</text>
  </view>

  <view class="card row-card" bindtap="goPrivacy">
    <text class="row-label">📄 隐私政策</text>
    <text class="row-value">查看 ›</text>
  </view>

  <view class="section-head">
    <text class="section-title">我参加的活动</text>
  </view>

  <view class="card mine" wx:for="{{myActivities}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="mine-top">
      <view class="type-badge" style="background:{{item.color}}1F;color:{{item.color}}"><image class="tag-icon" src="{{item.typeIcon}}"/> {{item.typeName}}</view>
      <view class="mine-status">{{item.myStatusText}}</view>
    </view>
    <view class="mine-title">{{item.title}}</view>
    <view class="mine-meta">🕐 {{item.timeText}} <text class="mine-count {{item.countdownKind}}">{{item.countdownText}}</text></view>
  </view>

  <view class="empty" wx:if="{{!myActivities.length}}">
    <view class="empty-icon">🗓️</view>
    <view class="empty-text">最近还没有报名参加的活动</view>
  </view>

  <view class="about">
    <view class="about-line">Paddy小助手 {{version}}</view>
    <view class="about-line">和朋友们一起，把周末过得热气腾腾</view>
    <view class="reset-link" bindtap="resetDemo">恢复演示数据</view>
  </view>
</view>

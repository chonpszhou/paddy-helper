.tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.68);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #9A8F86;
  border-radius: 999rpx;
}

.tab-active {
  background: #FFFFFF;
  color: #07C160;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.12);
}

.activity-card {
  margin-bottom: 20rpx;
}

.act-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
}

.type-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.tag-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.act-title {
  font-size: 32rpx;
  font-weight: 800;
  flex: 1;
  min-width: 0;
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.act-meta {
  font-size: 26rpx;
  color: #6F675F;
  margin-top: 6rpx;
}

.act-count {
  display: inline-block;
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(7, 193, 96, 0.12);
  color: #07C160;
}

.act-count.ended {
  background: rgba(154, 160, 175, 0.14);
  color: #8A919E;
}

.act-count.live {
  background: rgba(255, 92, 122, 0.12);
  color: #FF5C7A;
}

.act-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EFE8;
}

.act-join {
  font-size: 24rpx;
  color: #9A8F86;
}

.act-detail {
  font-size: 25rpx;
  color: #07C160;
  font-weight: 600;
}

.add-line {
  text-align: center;
  color: #07C160;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0 8rpx;
}

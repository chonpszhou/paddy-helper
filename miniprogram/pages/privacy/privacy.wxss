.page {
  padding: 32rpx 28rpx 80rpx;
}

.head {
  padding: 8rpx 8rpx 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #EAF0F8;
}

.head-sub {
  font-size: 24rpx;
  color: #7C8698;
  margin-top: 10rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #EAF0F8;
  margin-bottom: 18rpx;
}

.sec-item {
  display: flex;
  margin-bottom: 16rpx;
}

.sec-item:last-child {
  margin-bottom: 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #00E5A0;
  margin: 14rpx 16rpx 0 0;
  flex-shrink: 0;
}

.sec-text {
  flex: 1;
  font-size: 26rpx;
  color: #C7D0DE;
  line-height: 1.7;
}

.foot {
  font-size: 23rpx;
  color: #7C8698;
  text-align: center;
  padding: 30rpx 20rpx;
  line-height: 1.6;
}

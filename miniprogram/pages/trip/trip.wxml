<aurora-bg></aurora-bg>
<view class="page" wx:if="{{activity}}">
  <view class="card head">
    <view class="head-title">🗺️ {{activity.title}}</view>
    <view class="head-sub">🕐 {{timeText}}</view>
    <view class="head-sub head-loc" bindtap="openLocation">📍 {{activity.location || '地点待定'}}</view>
    <view class="head-sub head-addr" wx:if="{{activity.locationAddress && activity.locationAddress !== activity.location}}">{{activity.locationAddress}}</view>
  </view>

  <view class="ai-trigger" bindtap="aiTrip" hover-class="press-hover">
    <text class="ai-trigger-icon">✨</text>
    <view class="ai-trigger-texts">
      <view class="ai-trigger-title">AI 生成行程</view>
      <view class="ai-trigger-sub">输入目的地和天数，自动规划每日安排和预算</view>
    </view>
    <text class="ai-trigger-go">›</text>
  </view>

  <view class="card">
    <view class="card-title">🗓️ 行程规划</view>
    <view class="day" wx:for="{{days}}" wx:key="id">
      <view class="day-head">
        <view class="day-title">{{item.title}}</view>
        <view class="day-add" bindtap="addItem" data-day-id="{{item.id}}">＋ 加安排</view>
      </view>
      <view class="item" wx:for="{{item.items}}" wx:for-item="it" wx:key="id">
        <view class="item-time">{{it.time}}</view>
        <view class="item-content">{{it.content}}</view>
        <view class="item-del" catchtap="removeItem" data-day-id="{{item.id}}" data-item-id="{{it.id}}">✕</view>
      </view>
      <view class="empty-mini" wx:if="{{!item.items.length}}">还没有安排</view>
    </view>
    <view class="empty" wx:if="{{!days.length}}">
      <view class="empty-text">还没有行程，添加一天吧</view>
    </view>
    <view class="add-line" bindtap="addDay">＋ 添加一天</view>
  </view>

  <view class="card">
    <view class="card-title">🙋 分工认领 <text class="title-tip">点一下认领</text></view>
    <view class="task" wx:for="{{tasks}}" wx:key="id" bindtap="toggleTask" data-task-id="{{item.id}}">
      <view class="task-name">{{item.name}}</view>
      <view class="task-status {{item.isMine ? 'task-status-mine' : ''}} {{item.taken ? '' : 'task-status-todo'}}">{{item.statusText}}</view>
    </view>
    <view class="empty" wx:if="{{!tasks.length}}">
      <view class="empty-text">还没有分工项</view>
    </view>
    <view class="add-line" bindtap="addTask">＋ 添加分工</view>
  </view>

  <view class="card">
    <view class="card-title">🏠 住宿登记</view>
    <view class="stay" wx:for="{{stays}}" wx:key="id">
      <view class="stay-emoji">{{item.ownerEmoji}}</view>
      <view class="stay-info">
        <view class="stay-name">{{item.name}}{{item.isMine ? '（我订）' : ''}}</view>
        <view class="stay-meta">¥{{item.cost}}/晚 × {{item.nights}}晚 = ¥{{item.total}} · {{item.ownerName}} 订</view>
      </view>
      <view class="item-del" wx:if="{{item.isMine}}" catchtap="removeStay" data-stay-id="{{item.id}}">✕</view>
    </view>
    <view class="form-row">
      <input class="form-input form-input-wide" placeholder="民宿/酒店名称" value="{{newStayName}}" bindinput="onStayName"/>
    </view>
    <view class="form-row">
      <input class="form-input" type="digit" placeholder="价格/晚" value="{{newStayCost}}" bindinput="onStayCost"/>
      <input class="form-input" type="number" placeholder="晚数" value="{{newStayNights}}" bindinput="onStayNights"/>
      <view class="form-btn" bindtap="addStay">登记</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">💰 预算 AA</view>
    <view class="expense" wx:for="{{expenses}}" wx:key="id">
      <view class="expense-info">
        <view class="expense-item">{{item.item}}</view>
        <view class="expense-payer">{{item.payerEmoji}} {{item.payerName}} 付</view>
      </view>
      <view class="expense-amount">¥{{item.amount}}</view>
      <view class="item-del" wx:if="{{item.isMine}}" catchtap="removeExpense" data-expense-id="{{item.id}}">✕</view>
    </view>
    <view class="expense-sum">
      <text class="sum-total">总花费 ¥{{total}}</text>
      <text class="sum-per">人均 ¥{{perPersonText}}（{{aaCount}} 人 AA）</text>
    </view>
    <view class="form-row">
      <input class="form-input form-input-wide" placeholder="项目，比如：油费" value="{{newExpenseItem}}" bindinput="onExpenseItem"/>
    </view>
    <view class="form-row">
      <input class="form-input" type="digit" placeholder="金额" value="{{newExpenseAmount}}" bindinput="onExpenseAmount"/>
      <view class="form-btn" bindtap="addExpense">记账</view>
    </view>
  </view>
</view>

<view class="page" wx:else>
  <view class="card empty-state">
    <view class="empty-state-icon">😵</view>
    <view class="empty-state-text">页面暂时打不开</view>
    <view class="empty-state-sub">活动可能已不存在，试试重新打开</view>
    <view class="back-btn" bindtap="goBack">返回</view>
  </view>
</view>
